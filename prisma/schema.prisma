generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Modelo minimo de verificacion para la fase Foundation.
/// No representa el modelo de negocio.
model SystemProbe {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

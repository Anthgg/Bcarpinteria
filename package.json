{
  "name": "carpinteria-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de Carpinteria Ordenada 360 - V1",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "prisma migrate deploy && nodemon --legacy-watch --watch src --ext ts --delay 0.6 --exec \"npm run build && node dist/main.js\"",
    "start:dev:remote": "nodemon --legacy-watch --watch src --ext ts --delay 0.6 --exec \"npm run build && node dist/main.js\"",
    "start:dev:watch": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:reservation-concurrency": "node scripts/v1-reservation-concurrency.mjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.js",
    "seed:demo-users": "node scripts/seed-demo-users.cjs",
    "smoke:v1": "node scripts/v1-smoke.mjs",
    "db:supabase:status": "node scripts/supabase-migrate.cjs status",
    "db:supabase:deploy": "node scripts/supabase-migrate.cjs deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "2.117.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "jest": "^30.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.14",
    "typescript": "~5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "uuid": "^11.1.1"
  }
}

# =====================================================================
# Plantilla de entorno para la futura migración a Supabase (A015.0)
# =====================================================================
# Copia este archivo a `.env.supabase` y rellénalo A MANO:
#
#   Copy-Item .env.supabase.example .env.supabase
#
# `.env.supabase` está en .gitignore y .dockerignore: nunca lo subas,
# no lo pegues en chats ni en issues y no lo compartas por WhatsApp.
#
# IMPORTANTE: en esta fase NADIE lee este archivo. Docker Compose sigue
# usando PostgreSQL local (`.env` + compose.yml). No ejecutes
# `prisma migrate` / `prisma db push` contra Supabase hasta la fase A015.1.
#
# Leyenda:  [SECRETO] no compartir · [PÚBLICO] puede verse sin riesgo
#           [AHORA] lo usa el backend hoy · [FUTURO] se activará después
# =====================================================================


# ---------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------

# Puerto HTTP interno de NestJS. [PÚBLICO] [AHORA]
PORT=3000

# Etiqueta informativa del entorno; solo se muestra en GET /api/health.
# No activa ningún comportamiento. [PÚBLICO] [AHORA]
APP_ENV=SUPABASE


# ---------------------------------------------------------------------
# Base de datos (Supabase PostgreSQL)  [SECRETO] [FUTURO: A015.1]
# ---------------------------------------------------------------------
# Dónde obtenerlas: Supabase Dashboard > proyecto > botón "Connect"
# (Connection string). USER suele ser `postgres`, por lo que el usuario
# del pooler queda como `postgres.PROJECT_REF`. PASSWORD es la contraseña
# de la base definida al crear el proyecto (Database > Settings para
# restablecerla). Si la contraseña tiene caracteres especiales
# (@ : / ? # %), codifícalos en URL.
#
# Ambas cadenas terminan en `sslmode=require`: Prisma rechaza la conexión
# si no puede cifrarla en lugar de caer a texto plano.

# DATABASE_URL: conexión de RUNTIME que usa Prisma Client en la API.
# Para Cloud Run (instancias efímeras y muchas conexiones) usar el
# Supavisor TRANSACTION pooler, puerto 6543. Prisma necesita
# `pgbouncer=true` en ese modo (desactiva prepared statements) y
# conviene limitar conexiones por instancia con `connection_limit`.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"

# DIRECT_URL: conexión para Prisma CLI (migrate deploy / migrate status).
# Las migraciones NO funcionan a través del transaction pooler; usar el
# Supavisor SESSION pooler (puerto 5432) o la conexión directa
# (db.PROJECT_REF.supabase.co:5432, solo IPv6 salvo add-on IPv4) si el
# equipo que migra tiene esa conectividad. schema.prisma no declara
# `directUrl`: al migrar, pasa DIRECT_URL como DATABASE_URL solo para ese
# proceso (ver README > Preparación Supabase).
DIRECT_URL="postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"


# ---------------------------------------------------------------------
# Supabase API / Storage  [AHORA con STORAGE_DRIVER=supabase]
# ---------------------------------------------------------------------
# Solo el BACKEND usa estas variables. El frontend no habla con Supabase:
# sigue llamando a la API mediante VITE_API_BASE=/api. Nunca crees una
# variable VITE_* con la secret key (Vite la incrustaría en el bundle).

# URL del proyecto: https://PROJECT_REF.supabase.co
# Dónde: Dashboard > Project Settings > Data API. [PÚBLICO]
SUPABASE_URL=

# Secret key moderna (formato `sb_secret_...`). Omite RLS: equivale a
# acceso total al proyecto. Dónde: Dashboard > Project Settings >
# API Keys > Secret keys. [SECRETO] Solo el backend la usa para Storage,
# siempre después de autorizar la petición.
# No se usa la legacy `service_role` (SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_SECRET_KEY=

# Bucket PRIVADO para fotos de producción (lo crea
# scripts/migrate-photos-to-supabase.cjs: public=false, JPEG/PNG/WebP, 8 MB).
# Las fotos se sirven a través de la API, nunca por URL pública. [PÚBLICO]
SUPABASE_STORAGE_BUCKET=production-photos

# Controlador de almacenamiento de fotografías. [PÚBLICO]
#   local    -> UPLOAD_DIR (volumen Docker carpinteria_uploads)
#   supabase -> bucket SUPABASE_STORAGE_BUCKET, ruta production/{jobId}/{photoId}.{ext}
# Rollback: volver a `local` (los archivos locales se conservan).
STORAGE_DRIVER=supabase


# ---------------------------------------------------------------------
# Archivos locales  [PÚBLICO] [AHORA]
# ---------------------------------------------------------------------

# Carpeta de fotos cuando STORAGE_DRIVER=local.
UPLOAD_DIR=./uploads

# Excel de inventario de solo lectura (importación desde el panel).
BD_PATH="./bd/inventario g.xlsx"


# ---------------------------------------------------------------------
# Autenticación propia (NO Supabase Auth)  [AHORA]
# ---------------------------------------------------------------------
# La app mantiene User + Session + JWT y el RBAC TESTER/ADMIN/OPERARIO.

# Secreto para firmar sesiones; aleatorio, 32 bytes o más. [SECRETO]
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Orígenes del frontend permitidos, separados por comas (sin barra
# final), p. ej. la URL futura de Cloud Run. [PÚBLICO]
CORS_ORIGINS=

# URL pública base para enlaces de seguimiento y QR del PDF. [PÚBLICO]
PUBLIC_BASE_URL=


# ---------------------------------------------------------------------
# Web Push (opcional; vacío = notificaciones apagadas)  [AHORA]
# ---------------------------------------------------------------------
# Generar el par: npx web-push generate-vapid-keys

# Contacto del emisor: mailto:correo@dominio o URL https. [PÚBLICO]
VAPID_SUBJECT=
# Clave pública VAPID (la recibe el navegador). [PÚBLICO]
VAPID_PUBLIC_KEY=
# Clave privada VAPID. [SECRETO]
VAPID_PRIVATE_KEY=
# Códigos de pedido habilitados para pruebas de push, separados por comas.
PUSH_TEST_ORDER_CODES=

# Copy to .env and adjust the values. Never commit the real .env.

# Aplicacion
PORT=3000
APP_ENV=LOCAL

# PostgreSQL local (host: para prisma CLI en el host)
DATABASE_URL="postgresql://carpinteria:carpinteria_local@localhost:5432/carpinteria?schema=public"

# Excel de inventario de solo lectura; la importación ocurre desde el panel.
BD_PATH="./bd/inventario g.xlsx"

# Auth. En desarrollo, vacío genera una clave efímera al arrancar.
# En despliegues productivos define un secreto aleatorio de al menos 32 bytes.
JWT_SECRET=

# Orígenes CORS autorizados; el frontend del Compose local usa el mismo origen.
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173

# Fotografías guardadas en el volumen local de Docker.
UPLOAD_DIR="./uploads"
# local (este volumen) | supabase (bucket privado; ver .env.supabase.example)
STORAGE_DRIVER=local

# Seguimiento y notificaciones (opcional).
PUBLIC_BASE_URL="http://127.0.0.1:8080"
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_TEST_ORDER_CODES=
